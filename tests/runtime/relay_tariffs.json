{
  "tariffs": [
    {"id": "deepseek", "model": "deepseek-v4.1-flash", "expr": "(tier(\"base\", p * 0.3 + c * 1.2 + cr * 0.03)) * (hour(\"Asia/Shanghai\") >= 22 || hour(\"Asia/Shanghai\") < 8 ? 0.5 : 1)", "input": "0.3", "output": "1.2"},
