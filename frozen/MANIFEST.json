{
 "about": "Frozen question packs. Each entry names one pack: its job file, the freeze revision that froze it, the case count, the published prompt half (`q_file`), and sha256 values for the full pack (`file`, not distributed), for its canary-stamped form (`stamped_sha256`, the batch `cases.jsonl` whose prefix the freeze anchor records) and for each case (`per_case_sha256`, as `batch.json:cases_sha256` records it). `split_wq.py --check` verifies the entries against the Q files and the freeze anchor without the W half; `split_wq.py --join --verify` verifies them against the full pack.",
 "canary": {
  "field": "_canary",
  "marker": "haenv-canary-v1",
  "covers": [
   "frozen/*.Q.jsonl"
  ],
  "rebuild": "uv run python -m haenv.canary --write",
  "why": "Only the Q half is published, so it is the half a corpus filter must recognise. The strings sit in the top-level `_canary` field of every row, beside `case` and never inside it: `case` is rendered into the prompt, and a string there is a marker the solver can see.",
  "no_recorded_hash_moves": "`file_sha256` / `per_case_sha256` above are taken over `*.cases.jsonl`, which `split_wq.py --join` rebuilds from Q+W after stripping the field (it is the last key, so stripping restores the original key order).",
  "verify": "Strip the field from every row, re-serialise with ensure_ascii=False and separators=(',', ':'), one newline per row: the sha256 must equal `sha256_without_canary`. The file as shipped must equal `sha256_with_canary`. `split_wq.py --check` does both.",
  "packs": {
   "ddx-timeline.Q.jsonl": {
    "sha256_with_canary": "bf599888293c1f84bbf0c759235b299baec18b54328b45684e550ccb6dad93ec",
    "sha256_without_canary": "81c55b40610712c4a3e0affd831e47c912fbadda99789c4f96b57c1877c33f14"
   },
   "ddx-workup.Q.jsonl": {
    "sha256_with_canary": "efcb20ff2af871620d2f403da7667e312c50b99aefc00b4ea5ef45d4df8c2686",
    "sha256_without_canary": "28948f1069991b9d94abeb47d7cb687fdb4292c86d0c08c1cc3d672c6afa3055"
   }
  }
 },
